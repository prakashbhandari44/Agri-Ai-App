# ==========================================
# Krishi AI - Environment Configuration
# ==========================================

# AI Service Configuration
# GEMINI_API_KEY: Injected by AI Studio Secrets or runtime environment
GEMINI_API_KEY=MY_GEMINI_API_KEY
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-3.5-flash

# Backend API Configuration
BACKEND_API_BASE_URL=https://api.krishiai.np/v1/
DATABASE_URL=postgresql://krishi_admin:secure_pwd@db.krishiai.np:5432/krishi_db

# Agrometeorology Weather API
WEATHER_API_KEY=PLACEHOLDER_WEATHER_API_KEY
WEATHER_API_PROVIDER=open_meteo_nepal

# Cloud Storage & Authentication
STORAGE_BUCKET=krishi-ai-crop-scans-asia
AUTH_PROVIDER=firebase_or_jwt

# Monetization & Payment Gateway (eSewa / Khalti / Stripe)
PAYMENT_PROVIDER=esewa_or_khalti
PAYMENT_PROVIDER_KEY=PLACEHOLDER_PAYMENT_KEY
